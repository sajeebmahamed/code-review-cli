{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git push*)",
      "Bash(git worktree*)",
      "Bash(node *)",
      "Bash(cat *)",
      "Bash(ls *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "type": "command",
        "command": "bash .claude/hooks/block-dangerous.sh"
      },
      {
        "matcher": "Bash",
        "type": "command",
        "command": "bash .claude/hooks/credential-check.sh"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "type": "command",
        "command": "FILE=$TOOL_RESULT_FILE; if [[ \"$FILE\" == *.ts || \"$FILE\" == *.tsx || \"$FILE\" == *.json ]]; then npx prettier --write \"$FILE\" 2>/dev/null; fi"
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "type": "command",
        "command": "FILE=$TOOL_RESULT_FILE; if [[ \"$FILE\" == *.ts || \"$FILE\" == *.tsx ]]; then npx eslint --fix \"$FILE\" 2>/dev/null; fi"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "npm test -- --run 2>/dev/null && echo '✅ All tests pass' || echo '⚠️  Some tests failed — check before committing'"
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "echo '🚀 Claude Code session started for: Code Review CLI' && git status --short"
      }
    ]
  }
}
